# Server Port (for SSE mode)
PORT=3000

# Transport mode (sse or stdio)
TRANSPORT=sse

# Optional Redis Cache Configuration
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost

# Optional IsThereAnyDeal API Key (to enrich pricing comparisons)
ITAD_API_KEY=

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/gamedrop
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=password
# PGDATABASE=gamedrop

